set number
set relativenumber
set cursorline
set showmatch
set nowrap

set tabstop=4
set shiftwidth=4
set expandtab
set autoindent
set smartindent

set ignorecase
set smartcase
set hlsearch
set incsearch

syntax on
set termguicolors

set clipboard=unnamedplus
set backspace=indent,eol,start
set wildmenu
set mouse=a

set splitbelow
set splitright